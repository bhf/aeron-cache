<?xml version="1.0" encoding="UTF-8"?>
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="com.bhf.aeroncache.messages"
                   id="1"
                   version="0"
                   semanticVersion="0.1"
                   description="Messages used by Aeron Cache"
                   byteOrder="littleEndian">
    <types>
        <type name="Timestamp" primitiveType="uint64" semanticType="UTCTimestamp"/>
        <type name="Sequence" primitiveType="int64"/>
        <type name="CacheId" primitiveType="int64"/>
        <enum name="OperationStatus" encodingType="uint8">
            <validValue name="NONE">0</validValue>
            <validValue name="SUCCESS">1</validValue>
            <validValue name="ERROR">2</validValue>
            <validValue name="UNKNOWN_CACHE">3</validValue>
            <validValue name="UNKNOWN_KEY">4</validValue>
            <validValue name="CACHE_EXISTS">5</validValue>
            <validValue name="DUPLICATE_SUBSCRIPTION">6</validValue>
            <validValue name="UNKNOWN_SUBSCRIPTION">7</validValue>
        </enum>
        <composite name="messageHeader" description="Message identifiers and length of message root">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>
        <composite name="IntQty32" semanticType="Qty">
            <type name="mantissa" primitiveType="int32"/>
            <type name="exponent" primitiveType="int8" presence="constant">0</type>
        </composite>
        <composite name="Decimal64">
            <type name="mantissa" primitiveType="int64"/>
            <type name="exponent" primitiveType="int8" presence="constant">7</type>
        </composite>
        <composite name="groupSizeEncoding" description="Repeating group dimensions.">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="numInGroup" primitiveType="uint16"/>
        </composite>
        <composite name="varStringEncoding">
            <type name="length" primitiveType="uint32" maxValue="1073741824"/>
            <type name="varData" primitiveType="uint8" length="0" characterEncoding="UTF-8"/>
        </composite>
        <composite name="varBytesEncoding">
            <type name="length" primitiveType="uint32" maxValue="1073741824"/>
            <type name="varData" primitiveType="uint8" length="0"/>
        </composite>
        <enum name="BooleanType" encodingType="uint8" description="Boolean Type.">
            <validValue name="F" description="False value representation.">0</validValue>
            <validValue name="T" description="True value representation.">1</validValue>
        </enum>

        <enum name="BulkOperationType" encodingType="uint8">
            <validValue name="CREATE_CACHE">0</validValue>
            <validValue name="ADD_ITEM">1</validValue>
            <validValue name="REMOVE_ITEM">2</validValue>
            <validValue name="CLEAR_CACHE">3</validValue>
            <validValue name="GET_ITEM">4</validValue>
            <validValue name="DELETE_ITEM">5</validValue>
        </enum>
    </types>

    <sbe:message name="CreateCache" id="1" semanticType="CreateCache"
                 description="Create a cache">
        <data name="cacheId" id="1" type="varStringEncoding"/>
        <data name="requestId" id="2" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="DeleteCache" id="2" semanticType="DeleteCache"
                 description="Delete a cache">
        <data name="cacheId" id="1" type="varStringEncoding"/>
        <data name="requestId" id="2" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="ClearCache" id="3" semanticType="ClearCache"
                 description="Clear a cache">
        <data name="cacheId" id="1" type="varStringEncoding"/>
        <data name="requestId" id="2" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="AddCacheEntry" id="4" semanticType="AddCacheEntry"
                 description="Add an entry too a cache">
        <field name="ttl" id="1" type="int64"/>
        <data name="cacheId" id="2" type="varStringEncoding"/>
        <data name="requestId" id="3" type="varStringEncoding"/>
        <data name="key" id="4" type="varStringEncoding"/>
        <data name="entryValue" id="5" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="RemoveCacheEntry" id="5" semanticType="RemoveCacheEntry"
                 description="Remove an entry from a cache">
        <data name="cacheId" id="1" type="varStringEncoding"/>
        <data name="requestId" id="2" type="varStringEncoding"/>
        <data name="key" id="3" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="CacheCreated" id="6" semanticType="CacheCreated"
                 description="The ID of a created cache">
        <field name="status" id="1" type="OperationStatus"/>
        <data name="cacheId" id="2" type="varStringEncoding"/>
        <data name="requestId" id="3" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="CacheEntryCreated" id="7" semanticType="CacheEntryCreated"
                 description="An entry has been added to the cache">
        <field name="status" id="1" type="OperationStatus"/>
        <data name="cacheId" id="2" type="varStringEncoding"/>
        <data name="key" id="3" type="varStringEncoding"/>
        <data name="requestId" id="4" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="CacheEntryRemoved" id="8" semanticType="CacheEntryRemoved"
                 description="An entry has been removed from the cache">
        <field name="status" id="1" type="OperationStatus"/>
        <data name="cacheId" id="2" type="varStringEncoding"/>
        <data name="key" id="3" type="varStringEncoding"/>
        <data name="requestId" id="4" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="CacheCleared" id="9" semanticType="CacheCleared"
                 description="A cache has been cleared">
        <field name="status" id="1" type="OperationStatus"/>
        <data name="cacheId" id="2" type="varStringEncoding"/>
        <data name="requestId" id="3" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="CacheDeleted" id="10" semanticType="CacheDeleted"
                 description="A cache has been deleted">
        <field name="status" id="1" type="OperationStatus"/>
        <data name="cacheId" id="2" type="varStringEncoding"/>
        <data name="requestId" id="3" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="GetCacheEntry" id="11" semanticType="GetCacheEntry"
                 description="Get a specific cache entry">
        <data name="cacheId" id="1" type="varStringEncoding"/>
        <data name="key" id="2" type="varStringEncoding"/>
        <data name="requestId" id="3" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="CacheEntryResult" id="12" semanticType="CacheEntryResult"
                 description="The result of requesting a cache entry">
        <field name="status" id="1" type="OperationStatus"/>
        <data name="cacheId" id="2" type="varStringEncoding"/>
        <data name="key" id="3" type="varStringEncoding"/>
        <data name="value" id="4" type="varStringEncoding"/>
        <data name="requestId" id="5" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="AllCacheEntriesResult" id="13" semanticType="AllCacheEntriesResult"
                 description="Get all the entries from a cache">
        <field name="status" id="1" type="OperationStatus"/>
        <field name="endOfBatch" id="2" type="BooleanType"/>
        <group name="items" id="30" dimensionType="groupSizeEncoding">
            <data name="key" id="31" type="varStringEncoding"/>
            <data name="value" id="32" type="varStringEncoding"/>
        </group>
        <data name="requestId" id="4" type="varStringEncoding"/>
        <data name="cacheId" id="5" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="GetAllCacheEntries" id="14" semanticType="GetAllCacheEntries"
                 description="Get all entries in the specified cache">
        <data name="cacheId" id="1" type="varStringEncoding"/>
        <data name="requestId" id="2" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="GetCacheStats" id="15" semanticType="GetCacheStats"
                 description="Get stats on all caches">
        <data name="requestId" id="1" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="AllCacheStatsResult" id="16" semanticType="AllCacheStatsResult"
                 description="All of the cache stats">
        <field name="status" id="1" type="OperationStatus"/>
        <group name="stats" id="20" dimensionType="groupSizeEncoding">
            <field name="added" id="21" type="int64"/>
            <field name="removed" id="22" type="int64"/>
            <field name="cleared" id="23" type="int64"/>
            <field name="size" id="24" type="int64"/>
            <data name="cacheId" id="25" type="varStringEncoding"/>
        </group>
        <data name="requestId" id="3" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="CacheSubscriptionRequest" id="17" semanticType="CacheSubscriptionRequest"
                 description="Subscribe to cache updates">
        <data name="cacheId" id="1" type="varStringEncoding"/>
        <data name="requestId" id="2" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="CacheSubscriptionResponse" id="18" semanticType="CacheSubscriptionResponse"
                 description="Response to subscription request to a cache">
        <field name="status" id="1" type="OperationStatus"/>
        <data name="cacheId" id="2" type="varStringEncoding"/>
        <data name="requestId" id="3" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="CacheUnsubscribeRequest" id="19" semanticType="CacheUnsubscribeRequest"
                 description="Unsubscribe to cache updates">
        <data name="cacheId" id="1" type="varStringEncoding"/>
        <data name="requestId" id="2" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="CacheUnsubscribeResponse" id="20" semanticType="CacheUnsubscribeResponse"
                 description="Response to unsubscribe request to a cache">
        <field name="status" id="1" type="OperationStatus"/>
        <data name="cacheId" id="2" type="varStringEncoding"/>
        <data name="requestId" id="3" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="CacheEntryUpdate" id="21" semanticType="CacheEntryUpdate"
                 description="An update to a cache entry">
        <data name="cacheId" id="1" type="varStringEncoding"/>
        <data name="key" id="2" type="varStringEncoding"/>
        <data name="value" id="3" type="varStringEncoding"/>
        <data name="requestId" id="4" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="BulkOperationRequest" id="22" semanticType="BulkOpsRequest"
                 description="Conduct a bulk operation across the entire cache">
        <group name="items" id="30" dimensionType="groupSizeEncoding">
            <field name="operationType" id="29" type="BulkOperationType"/>
            <field name="ttl" id="30" type="int64"/>
            <data name="requestId" id="31" type="varStringEncoding"/>
            <data name="cacheId" id="32" type="varStringEncoding"/>
            <data name="key" id="33" type="varStringEncoding"/>
            <data name="value" id="34" type="varStringEncoding"/>
        </group>
        <data name="requestId" id="4" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="BulkOperationResponse" id="23" semanticType="BulkOpsResponse"
                 description="Response from a bulk operation request">
        <group name="items" id="30" dimensionType="groupSizeEncoding">
            <field name="operationStatus" id="30" type="OperationStatus"/>
            <data name="requestId" id="31" type="varStringEncoding"/>
            <data name="cacheId" id="32" type="varStringEncoding"/>
            <data name="key" id="33" type="varStringEncoding"/>
            <data name="value" id="34" type="varStringEncoding"/>
        </group>
        <data name="requestId" id="4" type="varStringEncoding"/>
    </sbe:message>

</sbe:messageSchema>