CLUSTER_NODE=
CLUSTER_ADDRESSES=localhost,localhost,localhost
EGRESS_IP=localhost
POD_ADDRESS=aeron-cache-http

// Config for single node cache + clients (Aeron response channels)
EPHEMERAL_REQUEST_ENDPOINT=localhost:8075
EPHEMERAL_RESPONSE_CONTROL_ENDPOINT=localhost:8076

// Cache mode
CACHE_MODE=SINGLE
DYNAMIC_CACHE_CREATION=false

// In-process scheduled snapshot + purge, run by the monolith's embedded ClusterTools scheduler.
// Applies only to clustered (RAFT) runs with CLUSTER_FOLDER set, so it is inert in this SINGLE-mode
// config; listed here for discoverability. The on-demand snapshot-and-purge endpoint is unaffected.
SNAPSHOT_SCHEDULE_ENABLED=false
SNAPSHOT_INTERVAL=PT6H
SNAPSHOT_RETENTION_COUNT=2
// Check strategy gating scheduled runs: ALWAYS | CACHE_STATE_CHANGE | RECORDING_GROWTH
SNAPSHOT_CHECK_STRATEGY=ALWAYS
// Poll interval for the CACHE_STATE_CHANGE / RECORDING_GROWTH strategies (ignored by ALWAYS)
SNAPSHOT_CHECK_POLL_INTERVAL=PT5M
// CACHE_STATE_CHANGE: state-changing cache ops since the last snapshot before snapshotting
SNAPSHOT_CHECK_STATE_CHANGE_THRESHOLD=10000
// RECORDING_GROWTH: archive growth in bytes since the last purge before snapshotting (256 MiB)
SNAPSHOT_CHECK_ARCHIVE_GROWTH_BYTES=268435456
