{
  "swagger": "2.0",
  "info": {
    "title": "Aeron Cache HTTP API",
    "description": "This API exposes endpoints to interact with Aeron Cache.",
    "termsOfService": "https://www.github.com/bhf",
    "contact": {
      "name": "Sanjeev",
      "url": "https://www.sanjeev.pages.dev",
      "email": "na@na.com"
    },
    "license": {
      "name": "MIT License",
      "url": "https://choosealicense.com/licenses/mit/"
    },
    "version": "1.0"
  },
  "host": "localhost:7070",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/cache": {
      "post": {
        "summary": "Create a new cache",
        "description": "Create a cache by specifying the cache Id in the request body",
        "operationId": "createCache",
        "tags": [
          "CreateCache"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/CreateResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateRequest"
            }
          }
        ]
      }
    },
    "/api/v1/cache/{cacheId}": {
      "get": {
        "summary": "Get all items from a cache",
        "description": "Get all items from the specified cache",
        "operationId": "getCache",
        "tags": [
          "GetCache"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/GetCacheResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "cacheId",
            "in": "path",
            "required": true,
            "description": "The ID of the cache",
            "type": "string"
          }
        ]
      },
      "post": {
        "summary": "Put an item into a cache",
        "description": "Put an item on the specified key into the specified cache",
        "operationId": "putItem",
        "tags": [
          "PutItem"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/PutItemResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "cacheId",
            "in": "path",
            "required": true,
            "description": "The ID of the cache",
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/PutItemRequest"
            }
          }
        ]
      },
      "delete": {
        "summary": "Delete a cache",
        "description": "Delete the cache specified by it's Id",
        "operationId": "deleteCache",
        "tags": [
          "DeleteCache"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/DeleteCacheResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "cacheId",
            "in": "path",
            "required": true,
            "description": "The ID of the cache",
            "type": "string"
          }
        ]
      },
      "patch": {
        "summary": "Clear a cache",
        "description": "Clear the cache specified by it's Id",
        "operationId": "clearCache",
        "tags": [
          "ClearCache"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ClearCacheResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "cacheId",
            "in": "path",
            "required": true,
            "description": "The ID of the cache",
            "type": "string"
          }
        ]
      }
    },
    "/api/v1/cache/{cacheId}/{key}": {
      "get": {
        "summary": "Get an item from a cache",
        "description": "Get an item by it's key from the specified cache",
        "operationId": "getItem",
        "tags": [
          "GetItem"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/GetItemResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "cacheId",
            "in": "path",
            "required": true,
            "description": "The ID of the cache",
            "type": "string"
          },
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "The key of the item",
            "type": "string"
          }
        ]
      },
      "delete": {
        "summary": "Delete an item from a cache",
        "description": "Delete an item by it's key from the specified cache",
        "operationId": "deleteItem",
        "tags": [
          "DeleteItem"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/DeleteItemResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "cacheId",
            "in": "path",
            "required": true,
            "description": "The ID of the cache",
            "type": "string"
          },
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "The key of the item",
            "type": "string"
          }
        ]
      }
    },
    "/api/v1/caches": {
      "get": {
        "summary": "Get all caches",
        "description": "Get the details of all available caches",
        "operationId": "getCaches",
        "tags": [
          "GetCaches"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/CacheDetails"
              }
            }
          }
        }
      }
    },
    "/api/v1/stats": {
      "get": {
        "summary": "Get cache status",
        "description": "Get global stats from the Aeron cache",
        "operationId": "getStats",
        "tags": [
          "Stats"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/CacheStatsResponse"
            }
          }
        }
      }
    },
    "/api/v1/shutdown": {
      "post": {
        "summary": "Shutdown Cluster",
        "description": "Shutdown the cluster",
        "operationId": "shutdownCluster",
        "tags": [
          "ClusterTools"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ClusterToolsResponse"
            }
          }
        }
      }
    },
    "/api/v1/snapshot": {
      "post": {
        "summary": "Take Snapshot",
        "description": "Take a cluster snapshot",
        "operationId": "takeSnapshot",
        "tags": [
          "ClusterTools"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ClusterToolsResponse"
            }
          }
        }
      }
    },
    "/liveness/": {
      "get": {
        "summary": "Liveness check",
        "description": "Check if the application is live",
        "operationId": "getLiveness",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "string"
            }
          }
        }
      }
    },
    "/readiness/": {
      "get": {
        "summary": "Readiness check",
        "description": "Check if the application is ready",
        "operationId": "getReadiness",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "errorMsg": {
          "type": "string",
          "example": "Details about the error that occurred"
        },
        "helpMsg": {
          "type": "string",
          "example": "A user friendly help message"
        }
      }
    },
    "CreateRequest": {
      "type": "object",
      "properties": {
        "cacheId": {
          "type": "string",
          "example": "SomeCacheId"
        }
      }
    },
    "CreateResponse": {
      "type": "object",
      "properties": {
        "cacheId": {
          "type": "string",
          "example": "SomeCacheId"
        }
      }
    },
    "GetCacheResponse": {
      "type": "object",
      "properties": {
        "cacheId": {
          "type": "string",
          "example": "CreatedCache"
        },
        "status": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CacheItem"
          }
        }
      }
    },
    "CacheItem": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "ClearCacheResponse": {
      "type": "object",
      "properties": {
        "cacheId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "CacheDetails": {
      "type": "object",
      "properties": {
        "cacheId": {
          "type": "string"
        },
        "itemCount": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "CacheStatsResponse": {
      "type": "object",
      "properties": {
        "totalOpsCount": {
          "type": "integer",
          "format": "int32"
        },
        "totalCachesCount": {
          "type": "integer",
          "format": "int32"
        },
        "totalItemsCount": {
          "type": "integer",
          "format": "int32"
        },
        "errorCount": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "ClusterToolsResponse": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "clusterToolsFolder": {
          "type": "string"
        },
        "exitCode": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "PutItemRequest": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "example": "SomeRandomKey"
        },
        "value": {
          "type": "string",
          "example": "SomeRandomValue"
        }
      }
    },
    "PutItemResponse": {
      "type": "object",
      "properties": {
        "cacheId": {
          "type": "string",
          "example": "SomeCacheId"
        },
        "key": {
          "type": "string",
          "example": "SomeRandomKey"
        }
      }
    },
    "DeleteCacheResponse": {
      "type": "object",
      "properties": {
        "cacheId": {
          "type": "string",
          "example": "SomeCacheId"
        }
      }
    },
    "GetItemResponse": {
      "type": "object",
      "properties": {
        "cacheId": {
          "type": "string",
          "example": "SomeCacheId"
        },
        "key": {
          "type": "string",
          "example": "SomeRandomKey"
        },
        "value": {
          "type": "string",
          "example": "SomeRandomValue"
        }
      }
    },
    "DeleteItemResponse": {
      "type": "object",
      "properties": {
        "cacheId": {
          "type": "string",
          "example": "SomeCacheId"
        },
        "key": {
          "type": "string",
          "example": "SomeRandomKey"
        }
      }
    }
  },
  "securityDefinitions": {}
}