<?xml version="1.0" encoding="UTF-8"?>
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="com.bhf.aeroncache.gateway.messages"
                   id="7"
                   version="0"
                   semanticVersion="0.1"
                   description="Client-facing wire protocol for the Aeron Cache gateway (commands + streaming subscriptions over Aeron transport)"
                   byteOrder="littleEndian">
    <types>
        <composite name="messageHeader" description="Message identifiers and length of message root">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>
        <composite name="groupSizeEncoding" description="Repeating group dimensions.">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="numInGroup" primitiveType="uint16"/>
        </composite>
        <composite name="varStringEncoding">
            <type name="length" primitiveType="uint32" maxValue="1073741824"/>
            <type name="varData" primitiveType="uint8" length="0" characterEncoding="UTF-8"/>
        </composite>

        <enum name="BooleanType" encodingType="uint8" description="Boolean Type.">
            <validValue name="F" description="False value representation.">0</validValue>
            <validValue name="T" description="True value representation.">1</validValue>
        </enum>

        <enum name="OperationStatus" encodingType="uint8">
            <validValue name="NONE">0</validValue>
            <validValue name="SUCCESS">1</validValue>
            <validValue name="ERROR">2</validValue>
            <validValue name="UNKNOWN_CACHE">3</validValue>
            <validValue name="UNKNOWN_KEY">4</validValue>
            <validValue name="CACHE_EXISTS">5</validValue>
            <validValue name="DUPLICATE_SUBSCRIPTION">6</validValue>
            <validValue name="UNKNOWN_SUBSCRIPTION">7</validValue>
        </enum>

        <enum name="UpdateEventType" encodingType="uint8" description="Mirrors CacheUpdateEvent.EventType">
            <validValue name="ADD_ITEM">0</validValue>
            <validValue name="REMOVE_ITEM">1</validValue>
            <validValue name="CLEAR_CACHE">2</validValue>
            <validValue name="DELETE_CACHE">3</validValue>
            <validValue name="PATCH_ITEM">4</validValue>
        </enum>

        <enum name="SubscriptionMode" encodingType="uint8"
              description="Whether a subscription receives full entry values or patch deltas.">
            <validValue name="FULL">0</validValue>
            <validValue name="PATCH">1</validValue>
        </enum>

        <enum name="BulkOperationType" encodingType="uint8"
              description="Mirrors com.bhf.aeroncache.models.bulk.requests.BulkOperationType (matched by name).">
            <validValue name="NONE">0</validValue>
            <validValue name="CREATE_CACHE">1</validValue>
            <validValue name="ADD_ITEM">2</validValue>
            <validValue name="REMOVE_ITEM">3</validValue>
            <validValue name="CLEAR_CACHE">4</validValue>
            <validValue name="GET_ITEM">5</validValue>
            <validValue name="DELETE_CACHE">6</validValue>
            <validValue name="PATCH_ITEM">7</validValue>
            <validValue name="CREATE_COUNTER_CACHE">8</validValue>
            <validValue name="ADD_COUNTER">9</validValue>
            <validValue name="REMOVE_COUNTER">10</validValue>
            <validValue name="CLEAR_COUNTER_CACHE">11</validValue>
            <validValue name="GET_COUNTER">12</validValue>
            <validValue name="DELETE_COUNTER_CACHE">13</validValue>
            <validValue name="INCREMENT_COUNTER">14</validValue>
            <validValue name="DECREMENT_COUNTER">15</validValue>
            <validValue name="SET_COUNTER">16</validValue>
            <validValue name="CANCEL_ITEM">17</validValue>
            <validValue name="CANCEL_COUNTER">18</validValue>
        </enum>
    </types>

    <!-- ================= Client -> Gateway ================= -->

    <sbe:message name="GatewayCommand" id="1" semanticType="GatewayCommand"
                 description="A request/response cache command. msgType maps onto CacheRequestMessageTypes.">
        <field name="msgType" id="1" type="uint16"/>
        <field name="ttl" id="2" type="int64"/>
        <field name="counterValue" id="3" type="int64"/>
        <data name="correlationId" id="4" type="varStringEncoding"/>
        <data name="cacheId" id="5" type="varStringEncoding"/>
        <data name="key" id="6" type="varStringEncoding"/>
        <data name="value" id="7" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="GatewaySubscribe" id="2" semanticType="GatewaySubscribe"
                 description="Subscribe to streaming updates for one or more caches.">
        <field name="sendSnapshot" id="1" type="BooleanType"/>
        <field name="counters" id="2" type="BooleanType"/>
        <group name="cacheIds" id="10" dimensionType="groupSizeEncoding">
            <field name="mode" id="12" type="SubscriptionMode"/>
            <data name="cacheId" id="11" type="varStringEncoding"/>
            <data name="key" id="13" type="varStringEncoding"/>
        </group>
        <data name="correlationId" id="3" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="GatewayUnsubscribe" id="3" semanticType="GatewayUnsubscribe"
                 description="Unsubscribe from streaming updates for a cache.">
        <field name="counters" id="1" type="BooleanType"/>
        <data name="correlationId" id="2" type="varStringEncoding"/>
        <data name="cacheId" id="3" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="GatewayBulkRequest" id="4" semanticType="GatewayBulkRequest"
                 description="A batch of cache/counter operations applied atomically in order by the cluster. Mirrors BulkCacheOpsRequest: each operation carries its own per-operation requestId, echoed on the matching bulk response entry.">
        <group name="operations" id="50" dimensionType="groupSizeEncoding">
            <field name="operationType" id="51" type="BulkOperationType"/>
            <field name="ttl" id="52" type="int64"/>
            <field name="counterValue" id="53" type="int64"/>
            <data name="requestId" id="54" type="varStringEncoding"/>
            <data name="cacheId" id="55" type="varStringEncoding"/>
            <data name="key" id="56" type="varStringEncoding"/>
            <data name="value" id="57" type="varStringEncoding"/>
        </group>
        <data name="correlationId" id="1" type="varStringEncoding"/>
    </sbe:message>

    <!-- ================= Gateway -> Client ================= -->

    <sbe:message name="GatewayCommandResponse" id="10" semanticType="GatewayCommandResponse"
                 description="The response to a GatewayCommand, correlated via correlationId.">
        <field name="status" id="1" type="OperationStatus"/>
        <data name="correlationId" id="2" type="varStringEncoding"/>
        <data name="cacheId" id="3" type="varStringEncoding"/>
        <data name="key" id="4" type="varStringEncoding"/>
        <data name="value" id="5" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="GatewayStreamUpdate" id="11" semanticType="GatewayStreamUpdate"
                 description="A streaming cache update pushed to a subscribed client.">
        <field name="eventType" id="1" type="UpdateEventType"/>
        <data name="cacheId" id="2" type="varStringEncoding"/>
        <data name="key" id="3" type="varStringEncoding"/>
        <data name="value" id="4" type="varStringEncoding"/>
        <data name="correlationId" id="5" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="GatewayError" id="12" semanticType="GatewayError"
                 description="An error response correlated via correlationId.">
        <field name="status" id="1" type="OperationStatus"/>
        <data name="correlationId" id="2" type="varStringEncoding"/>
        <data name="message" id="3" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="GatewayEntries" id="13" semanticType="GatewayEntries"
                 description="A batch of cache/counter entries streamed in response to a getEntries command. Mirrors the cluster AllCacheEntriesResult: entries are delivered in one or more batches, and the final batch for a request has endOfBatch=T.">
        <field name="status" id="1" type="OperationStatus"/>
        <field name="endOfBatch" id="2" type="BooleanType"/>
        <group name="items" id="30" dimensionType="groupSizeEncoding">
            <data name="key" id="31" type="varStringEncoding"/>
            <data name="value" id="32" type="varStringEncoding"/>
        </group>
        <data name="correlationId" id="3" type="varStringEncoding"/>
        <data name="cacheId" id="4" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="GatewayStats" id="14" semanticType="GatewayStats"
                 description="A batch of cache stats streamed in response to a getStats command. Mirrors the cluster AllCacheStatsResult: stats are delivered as a group, and the final batch for a request has endOfBatch=T.">
        <field name="status" id="1" type="OperationStatus"/>
        <field name="endOfBatch" id="2" type="BooleanType"/>
        <group name="stats" id="20" dimensionType="groupSizeEncoding">
            <field name="addedCount" id="21" type="int64"/>
            <field name="removedCount" id="22" type="int64"/>
            <field name="clearedCount" id="23" type="int64"/>
            <field name="size" id="24" type="int64"/>
            <data name="cacheId" id="25" type="varStringEncoding"/>
        </group>
        <data name="correlationId" id="3" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="GatewaySubscribeAck" id="15" semanticType="GatewaySubscribeAck"
                 description="Confirms a GatewaySubscribe is live: the cluster has registered the subscription, so updates for the requested caches will now be delivered. Emitted once per subscribe request, correlated via correlationId.">
        <field name="status" id="1" type="OperationStatus"/>
        <group name="cacheIds" id="40" dimensionType="groupSizeEncoding">
            <data name="cacheId" id="41" type="varStringEncoding"/>
        </group>
        <data name="correlationId" id="2" type="varStringEncoding"/>
    </sbe:message>

    <sbe:message name="GatewayBulkResponse" id="16" semanticType="GatewayBulkResponse"
                 description="The response to a GatewayBulkRequest, correlated via correlationId. Carries one result per requested operation, in request order; each result echoes its operation's per-operation requestId.">
        <group name="operations" id="60" dimensionType="groupSizeEncoding">
            <field name="status" id="61" type="OperationStatus"/>
            <data name="requestId" id="62" type="varStringEncoding"/>
            <data name="cacheId" id="63" type="varStringEncoding"/>
            <data name="key" id="64" type="varStringEncoding"/>
            <data name="value" id="65" type="varStringEncoding"/>
        </group>
        <data name="correlationId" id="1" type="varStringEncoding"/>
    </sbe:message>

</sbe:messageSchema>
