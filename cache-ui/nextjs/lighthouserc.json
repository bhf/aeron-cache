{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3002",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://127.0.0.1:3002/",
        "http://127.0.0.1:3002/observability"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
