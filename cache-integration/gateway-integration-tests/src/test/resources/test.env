# Embedded 3-node RAFT cluster launched in-process via ClusterLauncher.launchTestCluster(3, ...)
CLUSTER_NODE=
CLUSTER_ADDRESSES=localhost,localhost,localhost
EGRESS_IP=localhost
POD_ADDRESS=aeron-cache-gateway

# Cache mode
CACHE_MODE=RAFT

# NOTE: LAUNCH_EMBEDDED is intentionally NOT set. The cluster node reads it as
# "use an external (pre-existing) media driver" (default false -> each node launches its own),
# whereas the gateway reads it as "launch my own embedded media driver" (default true).
# Leaving it unset makes every component self-contained: each cluster node, the gateway and
# the test client each launch their own embedded media driver in a distinct Aeron directory.

# Bind the gateway's Aeron endpoints to localhost so the in-process client can reach them
# deterministically (the default request endpoint binds 0.0.0.0 and the response control
# endpoint uses the machine hostname).
GATEWAY_REQUEST_ENDPOINT=localhost:7075
GATEWAY_RESPONSE_CONTROL_ENDPOINT=localhost:7076
