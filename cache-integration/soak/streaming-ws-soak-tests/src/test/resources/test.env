# Embedded 3-node RAFT cluster launched in-process via ClusterLauncher.launchTestCluster(3, ...), fronted by
# BOTH the SBE gateway (the GatewayClient mutation path, bound to 7075/7076) and the Javalin websocket server
# (the subscription path under test). Identical in-process wiring to the streaming/core soak modules.
CLUSTER_NODE=
CLUSTER_ADDRESSES=localhost,localhost,localhost
EGRESS_IP=localhost
POD_ADDRESS=aeron-cache-gateway

# Cache mode
CACHE_MODE=RAFT

# Enable the near cache so the soak can exercise near-cache synthetic patch generation: the warm matrix cells
# prime a cache, open a hydrating patch subscription served from the warm copy, and assert the
# aeroncache_near_patches_total{outcome} counter. Read via System.getenv at WS server start, so it must live in
# the test JVM environment (loaded here by the build's environment(loadTestEnv())). Harmless for the other
# cells - a cache only goes warm when explicitly primed.
NEAR_CACHE_ENABLED=true

# Aeron term buffer length for the cache data channels. Kept small (16m) to bound the off-heap/tmpfs footprint
# of the in-process media drivers on a memory-constrained runner; the soak sends only small single ops.
AERON_CACHE_TERM_LENGTH=16m

# NOTE: LAUNCH_EMBEDDED intentionally unset so every component (cluster nodes, gateway, WS server, client)
# launches its own embedded media driver in a distinct Aeron directory.

# Bind the SBE gateway's Aeron endpoints to localhost so the in-process GatewayClient can reach them.
GATEWAY_REQUEST_ENDPOINT=localhost:7075
GATEWAY_RESPONSE_CONTROL_ENDPOINT=localhost:7076
