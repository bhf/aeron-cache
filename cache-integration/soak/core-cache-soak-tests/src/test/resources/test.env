# Embedded 3-node RAFT cluster launched in-process via ClusterLauncher.launchTestCluster(3, ...).
# Mirrors the gateway e2e module so the soak harness exercises the identical in-process wiring.
CLUSTER_NODE=
CLUSTER_ADDRESSES=localhost,localhost,localhost
EGRESS_IP=localhost
POD_ADDRESS=aeron-cache-gateway

# Cache mode
CACHE_MODE=RAFT

# Aeron term buffer length for the cache data channels. Each publication maps ~3x this off-heap, and
# with 5 in-process media drivers (3 cluster nodes + gateway + client) that mapped memory dominates the
# footprint on a memory-constrained GitHub runner. Unlike the gateway e2e module (which uses 128m to
# carry 250-item bulk batches), the soak sends only core single ops and streams getEntries in <=100-entry
# frames, so 16m is ample - the max Aeron message size is termLength/8 = 2m here - while cutting the
# mapped/tmpfs footprint ~8x versus 128m. Loaded into the test JVM environment by the build, so every
# in-process component (cluster nodes, gateway, and via applyConfiguredTermLength the client driver) uses it.
AERON_CACHE_TERM_LENGTH=16m

# NOTE: LAUNCH_EMBEDDED is intentionally NOT set. The cluster node reads it as "use an external
# (pre-existing) media driver" (default false -> each node launches its own), whereas the gateway
# reads it as "launch my own embedded media driver" (default true). Leaving it unset makes every
# component self-contained with its own embedded media driver in a distinct Aeron directory.

# Bind the gateway's Aeron endpoints to localhost so the in-process client can reach them
# deterministically (the default request endpoint binds 0.0.0.0 and the response control endpoint
# uses the machine hostname).
GATEWAY_REQUEST_ENDPOINT=localhost:7075
GATEWAY_RESPONSE_CONTROL_ENDPOINT=localhost:7076
