# Embedded 3-node RAFT cluster launched in-process via ClusterLauncher.launchTestCluster(3, ...).
# Identical in-process wiring to the core-cache soak and gateway e2e modules.
CLUSTER_NODE=
CLUSTER_ADDRESSES=localhost,localhost,localhost
EGRESS_IP=localhost
POD_ADDRESS=aeron-cache-gateway

# Cache mode
CACHE_MODE=RAFT

# Aeron term buffer length for the cache data channels. Kept small (16m) to bound the off-heap/tmpfs
# footprint of the 5 in-process media drivers on a memory-constrained runner; the streaming soak sends
# only small single ops, so the max Aeron message size (termLength/8 = 2m) is far more than enough.
AERON_CACHE_TERM_LENGTH=16m

# NOTE: LAUNCH_EMBEDDED intentionally unset so every component (cluster nodes, gateway, client) launches
# its own embedded media driver in a distinct Aeron directory.

# Bind the gateway's Aeron endpoints to localhost so the in-process client can reach them deterministically.
GATEWAY_REQUEST_ENDPOINT=localhost:7075
GATEWAY_RESPONSE_CONTROL_ENDPOINT=localhost:7076
